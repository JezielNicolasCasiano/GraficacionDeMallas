<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="296.0" prefWidth="1033.0" spacing="6.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controles.panelMallasController">
    <children>
        <!-- MENÚ SUPERIOR -->
        <MenuBar>
            <menus>
                <Menu mnemonicParsing="false" text="Vértices">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#handleAgregarVertice" text="Agregar Vértice" />
                        <MenuItem mnemonicParsing="false" onAction="#handleEliminarVertice" text="Eliminar Vértice" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Polígonos">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#handleCrearPoligono" text="Crear Polígono" />
                        <MenuItem mnemonicParsing="false" onAction="#handleEliminarPoligono" text="Eliminar Polígono" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Operaciones / Consultas">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#handleConsultarCara" text="Consultar Puntos de Cara" />
                        <MenuItem mnemonicParsing="false" onAction="#handleCalcularMalla" text="Calcular Área y Perímetro Total" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" onAction="#handleActualizar" text="Refrescar Tabla" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edición">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#handleEliminarVertice" text="Eliminar Vértice por ID" />
                        <MenuItem mnemonicParsing="false" onAction="#handleEliminarPoligono" text="Eliminar Polígono por ID" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" onAction="#handleLimpiar" text="Reiniciar Malla" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="6.0" left="6.0" right="6.0" top="2.0" />
            </padding>
            <children>
                <!-- SECCIÓN SUPERIOR: TABLA Y CONSOLA -->
                <HBox prefHeight="150.0" prefWidth="1021.0" spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tablaPoligonos" prefHeight="130.0" prefWidth="680.0" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colIdPoligono" prefWidth="90.0" text="ID Polígono" />
                                <TableColumn fx:id="colPuntos" prefWidth="350.0" text=" Vértices" />
                                <TableColumn fx:id="colArea" prefWidth="110.0" text="Área" />
                                <TableColumn fx:id="colPerimetro" prefWidth="110.0" text="Perímetro" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <VBox prefWidth="320.0" spacing="4.0">
                            <children>
                                <Label text="Consola de Resultados:">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Label>
                                <TextArea fx:id="txtResultados" editable="false" prefHeight="130.0" prefWidth="320.0" promptText="Los eventos y respuestas del menú aparecerán aquí..." wrapText="true" VBox.vgrow="ALWAYS">
                                    <font>
                                        <Font size="11.0" />
                                    </font>
                                </TextArea>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Separator prefWidth="200.0" />

                <!-- SECCIÓN INFERIOR: CONTROLES ENTRADA -->
                <HBox prefHeight="80.0" prefWidth="1021.0" spacing="10.0">
                    <children>
                        <!-- Bloque 1: Agregar Vértice -->
                        <VBox prefWidth="200.0" spacing="4.0" style="-fx-background-color: #f0f0f0; -fx-padding: 6; -fx-border-radius: 4; -fx-background-radius: 4;">
                            <children>
                                <Button fx:id="btnAgregarVertice" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAgregarVertice" text="Agregar Vértice">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Button>
                                <HBox alignment="CENTER_LEFT" spacing="4.0">
                                    <children>
                                        <Label text="X:" />
                                        <TextField fx:id="txtX" prefWidth="55.0" promptText="0.0" />
                                        <Label text="Y:" />
                                        <TextField fx:id="txtY" prefWidth="55.0" promptText="0.0" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Bloque 2: Crear Polígono -->
                        <VBox prefWidth="220.0" spacing="4.0" style="-fx-background-color: #f0f0f0; -fx-padding: 6; -fx-border-radius: 4; -fx-background-radius: 4;">
                            <children>
                                <Button fx:id="btnCrearPoligono" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCrearPoligono" text=" Crear Polígono">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Button>
                                <HBox alignment="CENTER_LEFT" spacing="4.0">
                                    <children>
                                        <Label text="Índices:" />
                                        <TextField fx:id="txtIndices" prefWidth="150.0" promptText="ej: 0, 1, 2" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Bloque 3: Consultar Cara -->
                        <VBox prefWidth="180.0" spacing="4.0" style="-fx-background-color: #f0f0f0; -fx-padding: 6; -fx-border-radius: 4; -fx-background-radius: 4;">
                            <children>
                                <Button fx:id="btnConsultarCara" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleConsultarCara" text="Consultar Cara">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Button>
                                <HBox alignment="CENTER_LEFT" spacing="4.0">
                                    <children>
                                        <Label text="N° Cara:" />
                                        <TextField fx:id="txtNumCara" prefWidth="90.0" promptText="ID" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Bloque 4: Eliminar Vértice/Polígono -->
                        <VBox prefWidth="220.0" spacing="4.0" style="-fx-background-color: #f0f0f0; -fx-padding: 6; -fx-border-radius: 4; -fx-background-radius: 4;">
                            <children>
                                <HBox spacing="4.0">
                                    <children>
                                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEliminarVertice" text="Vértice" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Button>
                                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEliminarPoligono" text="Polígono" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="4.0">
                                    <children>
                                        <Label text="ID Eliminar:" />
                                        <TextField fx:id="txtIdEliminar" prefWidth="120.0" promptText="Índice ID" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Bloque 5: Métricas y Limpieza -->
                        <VBox prefWidth="180.0" spacing="4.0" style="-fx-background-color: #f0f0f0; -fx-padding: 6; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS">
                            <children>
                                <Button fx:id="btnCalcularMalla" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCalcularMalla" text="Calcular Malla">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Button>
                                <HBox alignment="CENTER" spacing="6.0">
                                    <children>
                                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#handleLimpiar" text="Limpiar" />
                                        <Button fx:id="btnActualizarTabla" mnemonicParsing="false" onAction="#handleActualizar" text="Refrescar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
