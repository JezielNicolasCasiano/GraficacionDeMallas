<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="8.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controles.panelMallasController">
   <padding>
      <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
   </padding>
   <children>
      <TableView fx:id="tablaPuntos" minWidth="150.0" prefWidth="170.0">
         <columns>
            <TableColumn fx:id="colIdPunto" minWidth="50.0" prefWidth="50.0" text="Punto" />
            <TableColumn fx:id="colX" prefWidth="55.0" text="X" />
            <TableColumn fx:id="colY" prefWidth="55.0" text="Y" />
         </columns>
         <placeholder>
            <Label text="Sin puntos" />
         </placeholder>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <TableView fx:id="tablaPoligonos" prefWidth="220.0" HBox.hgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colIdPoligono" prefWidth="40.0" text="ID" />
            <TableColumn fx:id="colPuntos" prefWidth="170.0" text="Puntos" />
         </columns>
         <placeholder>
            <Label text="Sin polígonos" />
         </placeholder>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <VBox minWidth="330.0" spacing="6.0">
         <children>
            <Label text="Construir polígono">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="4.0">
               <children>
                  <ComboBox fx:id="cBoxPunto" prefWidth="150.0" promptText="Punto" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleAgregarPunto" text="Agregar" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleQuitarUltimo" text="Quitar último" />
               </children>
            </HBox>
            <Label fx:id="lblConstruccion" wrapText="true" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCrearPoligono" text="Crear polígono" />
            <Separator />
            <Label text="Polígono seleccionado">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="4.0">
               <children>
                  <Label minWidth="-Infinity" text="ID" />
                  <ComboBox fx:id="cBoxPoligono" prefWidth="80.0" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleArea" text="Área" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handlePerimetro" text="Perímetro" />
               </children>
            </HBox>
            <HBox spacing="4.0">
               <children>
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleEliminarPoligono" text="Eliminar polígono" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleReiniciar" text="Reiniciar malla" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
